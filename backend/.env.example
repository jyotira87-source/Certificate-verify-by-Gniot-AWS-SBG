# Advance Certificate Verification — Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=4000
NODE_ENV=development

# Storage
DATA_DIR=./backend
DB_FILE=./backend/db.json
AUDIT_FILE=./backend/audit.json
VERIFICATION_LOG_FILE=./backend/verification-log.json

# Security (CHANGE THESE IN PRODUCTION)
SESSION_SECRET=your-random-session-secret-here
ADMIN_USERNAME=admin
# Generate with: node -e "const bcrypt=require('bcryptjs'); bcrypt.hash('your-password',12).then(h=>console.log(h))"
ADMIN_PASSWORD_HASH=
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN=*

# Public URL (for QR codes and verification links)
PUBLIC_URL=http://localhost:4000

# Upload limits
MAX_UPLOAD_SIZE=10485760

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW=60000
API_RATE_LIMIT_MAX=100
